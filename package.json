{
  "name": "pit-wall-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Nguyễn Phúc Hưng — mùa giải đua xe 6 chặng. Site tĩnh, không cần build; npm chỉ dùng cho tooling.",
  "scripts": {
    "serve": "http-server -p 4173 -c-1 .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:data && npm run test:e2e",
    "test:data": "node --test tests/data.spec.js",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.13.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "serve": "^14.2.8"
  }
}
